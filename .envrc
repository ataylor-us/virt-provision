export TF_VAR_vm_password_hash="$(pass virt-provision/vm_password_hash)"
# Each mac goes in a seperate pass entry
export TF_VAR_mac_addresses="{
  dev1 = \"$(pass virt-provision/dev1_mac_address)\"
  dev2 = \"$(pass virt-provision/dev2_mac_address)\"
  dev3 = \"$(pass virt-provision/dev3_mac_address)\"
  exit = \"$(pass virt-provision/exit_mac_address)\"
  bog = \"$(pass virt-provision/bog_mac_address)\"
  frontend = \"$(pass virt-provision/frontend_mac_address)\"
  hub = \"$(pass virt-provision/hub_mac_address)\"
  hive = \"$(pass virt-provision/hive_mac_address)\"
  haos = \"$(pass virt-provision/haos_mac_address)\"
}"
